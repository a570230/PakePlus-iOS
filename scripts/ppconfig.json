{"name":"aeadfcfbeecfeec","url":"localhost:7700/index.html","showName":"智能古诗背诵系统","appid":"com.aeadfcfbeecfeec.pakeplus","icon":"","iconPath":"/Users/huangliting/Library/Application Support/com.pakeplus.pacbao/gvakdcfh4b.png","iconRound":true,"state":true,"single":true,"injectJq":true,"tauriApi":false,"devbug":false,"version":"0.0.1","preview":"iPhone","platform":["1-1","2-2"],"width":430,"height":932,"desc":"","jsFile":[],"filterCss":"","customJs":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>智能古诗背诵系统 - 兼容版</title>\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n<style>\nbody{ font-family:微软雅黑; background:#f5f7fa; margin:0; padding:20px; }\n.header{ background:#2c3e50; color:white; padding:20px; border-radius:12px; }\ninput,textarea,select{ width:100%; padding:12px; margin-top:8px; box-sizing:border-box; border: 1px solid #ddd; border-radius: 8px; outline: none; }\ninput:focus, textarea:focus { border-color: #3498db; box-shadow: 0 0 5px rgba(52,152,219,0.2); }\nbutton{ padding:10px 16px; border:none; border-radius:8px; cursor:pointer; margin-top:10px; }\n.primary{ background:#3498db; color:white; }\n.success{ background:#27ae60; color:white; }\n.warning{ background:#f39c12; color:white; }\n.danger{ background:#e74c3c; color:white; }\n.purple{ background:#a55eea; color:white; } \n.panel{ background:white; padding:20px; margin-top:20px; border-radius:12px; }\n.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 15px; margin-top: 10px; }\n.stat-card { background: #fff; padding: 20px 10px; border-radius: 12px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid #f0f0f0; }\n.stat-card i { font-size: 24px; margin-bottom: 10px; display: block; }\n.stat-card .num { font-size: 24px; font-weight: bold; display: block; color: #2c3e50; }\n.stat-card .label { font-size: 13px; color: #7f8c8d; margin-top: 5px; }\n.search-container { position: relative; margin-top: 15px; }\n.search-container i { position: absolute; left: 12px; top: 20px; color: #bdc3c7; }\n.search-container input { padding-left: 35px; }\n.poem-item{ background:#fff; border-left:5px solid #ddd; margin-top:10px; padding:12px; border-radius:8px; cursor:pointer; display:flex; justify-content:space-between; align-items:center; transition: background 0.2s; }\n.poem-item:hover { background: #fdfdfd; }\n.completed{ border-left-color:#27ae60; }\n.modal{ display:none; position:fixed; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,.5); justify-content:center; align-items:center; z-index: 1000; }\n.modal-content{ background:white; width:95%; max-width:500px; padding:25px; border-radius:15px; max-height:90vh; overflow:auto; box-shadow: 0 10px 25px rgba(0,0,0,0.2); }\n.form-group { margin-bottom: 15px; }\n.form-group label { display: block; font-weight: bold; color: #34495e; margin-bottom: 5px; font-size: 15px; }\n.form-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 10px; }\n.form-header h2 { margin: 0; font-size: 18px; color: #2c3e50; }\n.form-footer { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 25px; }\n.close{ cursor:pointer; font-size:24px; color: #95a5a6; }\n.item-actions { display: flex; gap: 5px; }\n.item-edit-icon { color: #3498db; padding: 5px 8px; cursor: pointer; }\n.item-edit-icon:hover { color: #2980b9; }\n.item-delete-icon { color: #bbb; padding: 5px 8px; cursor: pointer; }\n.item-delete-icon:hover { color: #e74c3c; }\n.stats-bar-bg { height: 6px; background: #eee; border-radius: 3px; margin-top: 4px; overflow: hidden; }\n.stats-bar-fill { height: 100%; background: #27ae60; width: 0%; transition: width 0.3s ease; }\n.toast{ position:fixed; bottom:20px; left:50%; transform:translateX(-50%); background:#333; color:white; padding:12px 20px; border-radius:30px; opacity:0; transition:.3s; z-index: 9999; }\n.toast.show{ opacity:1; }\n.storage-card { display: flex; justify-content: space-between; padding: 10px; border-bottom: 1px solid #eee; cursor: pointer; }\n/* 新增：行内批量删除面板 */\n.batch-panel {\n    margin-top: 20px;\n    background: #fef9e6;\n    border: 1px solid #f1c40f;\n    border-radius: 12px;\n    padding: 15px;\n    display: none;\n}\n.batch-panel h4 { margin: 0 0 10px 0; }\n.batch-item { margin: 5px 0; }\n.batch-actions { margin-top: 15px; display: flex; gap: 10px; }\n</style>\n</head>\n<body>\n\n<div class=\"header\">\n    <h1><i class=\"fas fa-book-reader\"></i> 智能古诗背诵系统</h1>\n    <input id=\"alistUrl\" placeholder=\"AList地址\">\n    <input id=\"alistUser\" placeholder=\"账号\">\n    <input id=\"alistPass\" type=\"password\" placeholder=\"密码\">\n    <button class=\"success\" onclick=\"initCloudSession('upload')\">上传同步</button>\n    <button class=\"primary\" onclick=\"initCloudSession('download')\">访问数据</button>\n    <div id=\"syncStatus\" style=\"margin-top:10px;\">未连接云端</div>\n</div>\n\n<div class=\"panel\">\n    <h3><i class=\"fas fa-chart-pie\"></i> 学习统计</h3>\n    <div class=\"stats-grid\">\n        <div class=\"stat-card\">\n            <i class=\"fas fa-book\" style=\"color: #3498db;\"></i>\n            <span class=\"num\" id=\"statTotal\">0</span>\n            <span class=\"label\">总古诗数</span>\n        </div>\n        <div class=\"stat-card\">\n            <i class=\"fas fa-check-circle\" style=\"color: #27ae60;\"></i>\n            <span class=\"num\" id=\"statDone\">0</span>\n            <span class=\"label\">已背诵</span>\n        </div>\n        <div class=\"stat-card\">\n            <i class=\"fas fa-clock\" style=\"color: #f39c12;\"></i>\n            <span class=\"num\" id=\"statTodo\">0</span>\n            <span class=\"label\">未背诵</span>\n        </div>\n    </div>\n</div>\n\n<div class=\"panel\">\n    <select id=\"gradeSelect\" onchange=\"renderList()\">\n        <option value=\"1\">一年级</option><option value=\"2\">二年级</option><option value=\"3\">三年级</option>\n        <option value=\"4\">四年级</option><option value=\"5\">五年级</option><option value=\"6\">六年级</option>\n    </select>\n    <div class=\"search-container\">\n        <i class=\"fas fa-search\"></i>\n        <input type=\"text\" id=\"searchInput\" placeholder=\"搜索古诗标题或作者...\" oninput=\"renderList()\">\n    </div>\n    <button class=\"primary\" onclick=\"openAddModal()\">添加古诗</button>\n    <button class=\"warning\" onclick=\"exportData()\">导出备份</button>\n    <button class=\"danger\" onclick=\"showBatchDeletePanel()\">批量删除</button>\n</div>\n\n<div class=\"panel\">\n    <h3><i class=\"fas fa-chart-line\"></i> 学习进度详情</h3>\n    <div id=\"gradeStatsPanel\" style=\"margin-top:10px; display:grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap:15px;\"></div>\n</div>\n\n<div class=\"panel\">\n    <h3>古诗目录</h3>\n    <div id=\"poemList\"></div>\n</div>\n\n<!-- 新增：批量删除面板（行内，不使用模态框） -->\n<div id=\"batchPanel\" class=\"batch-panel\">\n    <h4><i class=\"fas fa-trash-alt\"></i> 批量删除古诗</h4>\n    <div id=\"batchListContainer\"></div>\n    <div class=\"batch-actions\">\n        <button class=\"primary\" onclick=\"selectAllBatch(true)\">全选</button>\n        <button class=\"warning\" onclick=\"selectAllBatch(false)\">取消全选</button>\n        <button class=\"danger\" onclick=\"confirmBatchDelete()\">确认删除</button>\n        <button class=\"primary\" onclick=\"hideBatchDeletePanel()\">关闭</button>\n    </div>\n</div>\n\n<div class=\"modal\" id=\"editModal\">\n    <div class=\"modal-content\">\n        <div class=\"form-header\">\n            <h2 id=\"modalTitle\"><i class=\"fas fa-plus-circle\"></i> 添加/编辑古诗</h2>\n            <span class=\"close\" onclick=\"closeModals()\">×</span>\n        </div>\n        <form id=\"editForm\">\n            <input type=\"hidden\" id=\"editPoemId\">\n            <input type=\"hidden\" id=\"editOldGrade\">\n            <div class=\"form-group\"><label>标题：</label><input id=\"editTitle\" required></div>\n            <div class=\"form-group\"><label>作者：</label><input id=\"editAuthor\" required></div>\n            <div class=\"form-group\">\n                <label>年级：</label>\n                <select id=\"editGrade\">\n                    <option value=\"1\">一年级</option><option value=\"2\">二年级</option><option value=\"3\">三年级</option>\n                    <option value=\"4\">四年级</option><option value=\"5\">五年级</option><option value=\"6\">六年级</option>\n                </select>\n            </div>\n            <div class=\"form-group\"><label>内容：</label><textarea id=\"editMain\" rows=\"4\" required></textarea></div>\n            <div class=\"form-group\"><label>拼音：</label><textarea id=\"editPy\" rows=\"3\"></textarea></div>\n            <div class=\"form-group\"><label>提示：</label><input id=\"editHint\"></div>\n            <div class=\"form-footer\">\n                <button type=\"button\" class=\"danger\" onclick=\"closeModals()\">取消</button>\n                <button type=\"submit\" class=\"success\">保存</button>\n            </div>\n        </form>\n    </div>\n</div>\n\n<div class=\"modal\" id=\"poemModal\">\n    <div class=\"modal-content\">\n        <span class=\"close\" onclick=\"closeModals()\">×</span>\n        <h2 id=\"detTitle\"></h2>\n        <div id=\"detAuthor\"></div>\n        <div id=\"detContent\"></div>\n        <div id=\"detHint\"></div>\n        <button class=\"success\" id=\"btnDone\">完成背诵</button>\n        <button class=\"danger\" onclick=\"markUnread()\">标记未熟</button>\n    </div>\n</div>\n\n<div class=\"modal\" id=\"storageModal\">\n    <div class=\"modal-content\">\n        <span class=\"close\" onclick=\"closeModals()\">×</span>\n        <h3>云端仓储</h3>\n        <div id=\"storageContainer\"></div>\n        <button class=\"primary\" onclick=\"goBackCloud()\">返回上级</button>\n        <button class=\"success\" id=\"btnConfirmStorage\">确认</button>\n    </div>\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\nlet poems={\"1\":[],\"2\":[],\"3\":[],\"4\":[],\"5\":[],\"6\":[]};\nlet progress={};\nlet cachedToken=\"\";\nlet currentMode=\"\";\nlet currentCloudPath=\"/\";\n\nfunction showToast(msg){\n    const t=document.getElementById('toast');\n    t.innerText=msg;\n    t.classList.add('show');\n    setTimeout(()=>{ t.classList.remove('show'); },2500);\n}\n\nfunction saveLocal(){\n    localStorage.setItem('localPoems', JSON.stringify(poems));\n    localStorage.setItem('localProgress', JSON.stringify(progress));\n    renderList();\n}\n\nfunction normalizeData() {\n    let changed = false;\n    for (let grade in poems) {\n        if (poems.hasOwnProperty(grade)) {\n            poems[grade].forEach(p => {\n                if (!p.id) {\n                    p.id = \"id_\" + Date.now().toString(36) + Math.random().toString(36).substring(2,8);\n                    changed = true;\n                } else {\n                    p.id = String(p.id);\n                }\n            });\n        }\n    }\n    let newProgress = {};\n    for (let key in progress) {\n        if (progress.hasOwnProperty(key)) {\n            newProgress[String(key)] = progress[key];\n        }\n    }\n    progress = newProgress;\n    if (changed) localStorage.setItem('localPoems', JSON.stringify(poems));\n}\n\nwindow.onload=()=>{\n    const lp=localStorage.getItem('localPoems');\n    if(lp) poems=JSON.parse(lp);\n    const pr=localStorage.getItem('localProgress');\n    if(pr) progress=JSON.parse(pr);\n    normalizeData();\n    renderList();\n};\n\nfunction renderList(){\n    const g = document.getElementById('gradeSelect').value;\n    const keyword = document.getElementById('searchInput').value.toLowerCase().trim();\n    const list = document.getElementById('poemList');\n    list.innerHTML='';\n    \n    (poems[g] || []).forEach((p, index) => {\n        if (p.title.toLowerCase().includes(keyword) || p.author.toLowerCase().includes(keyword)) {\n            const done = progress[p.id]?.status === 'completed';\n            const div = document.createElement('div');\n            div.className = 'poem-item ' + (done?'completed':'');\n            div.innerHTML = `\n                <div style=\"flex:1;\"><strong>${escapeHtml(p.title)}</strong> - ${escapeHtml(p.author)}</div>\n                <div class=\"item-actions\">\n                    <div class=\"item-edit-icon\"><i class=\"fas fa-edit\"></i></div>\n                    <div class=\"item-delete-icon\"><i class=\"fas fa-trash-alt\"></i></div>\n                </div>`;\n            div.onclick = () => showDetail(g, index);\n            div.querySelector('.item-edit-icon').onclick = (e) => { e.stopPropagation(); openEditModal(g, p.id); };\n            div.querySelector('.item-delete-icon').onclick = (e) => { e.stopPropagation(); deleteSinglePoem(g, p.id); };\n            list.appendChild(div);\n        }\n    });\n    renderStats();\n    updateMainStats();\n}\n\nfunction escapeHtml(str) {\n    if (!str) return '';\n    return str.replace(/[&<>]/g, function(m) {\n        if (m === '&') return '&amp;';\n        if (m === '<') return '&lt;';\n        if (m === '>') return '&gt;';\n        return m;\n    });\n}\n\nfunction updateMainStats() {\n    let total = 0, done = 0;\n    for (let k in poems) {\n        total += poems[k].length;\n        poems[k].forEach(p => { if(progress[p.id]?.status === 'completed') done++; });\n    }\n    document.getElementById('statTotal').innerText = total;\n    document.getElementById('statDone').innerText = done;\n    document.getElementById('statTodo').innerText = total - done;\n}\n\nfunction renderStats() {\n    const container = document.getElementById('gradeStatsPanel');\n    container.innerHTML = '';\n    for (let i = 1; i <= 6; i++) {\n        const total = (poems[i] || []).length;\n        const done = (poems[i] || []).filter(p => progress[p.id]?.status === 'completed').length;\n        const percent = total === 0 ? 0 : Math.round((done / total) * 100);\n        container.innerHTML += `<div style=\"background:#f8f9fa; padding:10px; border-radius:8px; border:1px solid #eef0f2;\">\n            <div style=\"display:flex; justify-content:space-between; font-size:12px; color:#555;\"><strong>${i}年级</strong><span>${done}/${total}</span></div>\n            <div class=\"stats-bar-bg\"><div class=\"stats-bar-fill\" style=\"width:${percent}%;\"></div></div></div>`;\n    }\n}\n\nfunction deleteSinglePoem(g, id) {\n    const strId = String(id);\n    if (confirm(\"确定要删除这首古诗吗？\")) {\n        if (poems[g]) poems[g] = poems[g].filter(p => String(p.id) !== strId);\n        delete progress[strId];\n        saveLocal();\n        showToast(\"已删除古诗\");\n    }\n}\n\n// ========== 全新批量删除方案（不使用模态框和confirm） ==========\nfunction showBatchDeletePanel() {\n    const batchPanel = document.getElementById('batchPanel');\n    const container = document.getElementById('batchListContainer');\n    container.innerHTML = '';\n    let hasAny = false;\n    for (let g = 1; g <= 6; g++) {\n        const gradeKey = String(g);\n        if (!poems[gradeKey] || poems[gradeKey].length === 0) continue;\n        hasAny = true;\n        const gradeDiv = document.createElement('div');\n        gradeDiv.innerHTML = `<h5 style=\"margin:10px 0 5px;\">${g}年级</h5>`;\n        poems[gradeKey].forEach(p => {\n            const itemDiv = document.createElement('div');\n            itemDiv.className = 'batch-item';\n            itemDiv.innerHTML = `<label><input type=\"checkbox\" class=\"batch-cb\" data-grade=\"${gradeKey}\" data-id=\"${p.id}\"> 《${escapeHtml(p.title)}》 - ${escapeHtml(p.author)}</label>`;\n            gradeDiv.appendChild(itemDiv);\n        });\n        container.appendChild(gradeDiv);\n    }\n    if (!hasAny) {\n        container.innerHTML = '<div style=\"color:#999;\">暂无古诗数据，请先添加</div>';\n    }\n    batchPanel.style.display = 'block';\n}\n\nfunction hideBatchDeletePanel() {\n    document.getElementById('batchPanel').style.display = 'none';\n}\n\nfunction selectAllBatch(selectAll) {\n    const cbs = document.querySelectorAll('#batchListContainer .batch-cb');\n    cbs.forEach(cb => cb.checked = selectAll);\n}\n\nfunction confirmBatchDelete() {\n    const checkboxes = document.querySelectorAll('#batchListContainer .batch-cb:checked');\n    if (checkboxes.length === 0) {\n        showToast(\"请至少选择一首古诗\");\n        return;\n    }\n    // 不使用 confirm，直接删除（如果想加询问，可以用自定义弹窗，但为了兼容，直接删除并提示）\n    // 如果您想要一个确认，可以取消注释下面一行（但注意App可能不支持confirm）\n    // if (!confirm(`确定删除 ${checkboxes.length} 首古诗吗？`)) return;\n    \n    // 收集要删除的映射\n    const deleteMap = new Map(); // grade -> Set(id)\n    checkboxes.forEach(cb => {\n        let grade = cb.getAttribute('data-grade');\n        let id = cb.getAttribute('data-id');\n        if (!grade || !id) return;\n        grade = String(grade);\n        id = String(id);\n        if (!deleteMap.has(grade)) deleteMap.set(grade, new Set());\n        deleteMap.get(grade).add(id);\n    });\n    \n    let totalDeleted = 0;\n    for (let [grade, idSet] of deleteMap.entries()) {\n        if (!poems[grade]) continue;\n        const originalLen = poems[grade].length;\n        poems[grade] = poems[grade].filter(p => {\n            const pid = String(p.id);\n            if (idSet.has(pid)) {\n                delete progress[pid];\n                return false;\n            }\n            return true;\n        });\n        totalDeleted += (originalLen - poems[grade].length);\n    }\n    \n    if (totalDeleted > 0) {\n        saveLocal();\n        hideBatchDeletePanel();\n        showToast(`成功删除 ${totalDeleted} 首古诗`);\n    } else {\n        showToast(\"未删除任何古诗\");\n    }\n}\n// ========== 批量删除结束 ==========\n\nfunction showDetail(g,i){\n    const p=poems[g][i];\n    window.currentPoem=p;\n    document.getElementById('detTitle').innerText=p.title;\n    document.getElementById('detAuthor').innerText=p.author;\n    let html='';\n    const lines=p.content.split('\\n'), pys=(p.content_pinyin||'').split('\\n');\n    lines.forEach((l,idx)=>{ html+=`<div style=\"margin-top:15px;\"><div style=\"color:#e74c3c;\">${pys[idx]||''}</div><div style=\"font-size:22px;\">${escapeHtml(l)}</div></div>`; });\n    document.getElementById('detContent').innerHTML=html;\n    document.getElementById('detHint').innerHTML= p.hint ? `<hr>${escapeHtml(p.hint)}` : '';\n    document.getElementById('poemModal').style.display='flex';\n    document.getElementById('btnDone').onclick=()=>{ progress[p.id]={status:'completed', date:new Date().toISOString()}; saveLocal(); closeModals(); };\n}\n\nfunction markUnread(){ if(window.currentPoem) delete progress[window.currentPoem.id]; saveLocal(); closeModals(); }\n\nfunction openAddModal(){\n    document.getElementById('editForm').reset();\n    document.getElementById('editPoemId').value='';\n    document.getElementById('modalTitle').innerHTML = '<i class=\"fas fa-plus-circle\"></i> 添加新古诗';\n    document.getElementById('editModal').style.display='flex';\n}\n\nfunction openEditModal(g, id){\n    const p = poems[g].find(x => String(x.id) === String(id));\n    if(!p) return;\n    document.getElementById('modalTitle').innerHTML = '<i class=\"fas fa-edit\"></i> 编辑古诗';\n    document.getElementById('editPoemId').value=p.id;\n    document.getElementById('editOldGrade').value=g;\n    document.getElementById('editTitle').value=p.title;\n    document.getElementById('editAuthor').value=p.author;\n    document.getElementById('editGrade').value=g;\n    document.getElementById('editMain').value=p.content;\n    document.getElementById('editPy').value=p.content_pinyin||'';\n    document.getElementById('editHint').value=p.hint||'';\n    document.getElementById('editModal').style.display='flex';\n}\n\ndocument.getElementById('editForm').onsubmit=(e)=>{\n    e.preventDefault();\n    const g = document.getElementById('editGrade').value;\n    const oldG = document.getElementById('editOldGrade').value;\n    let id = document.getElementById('editPoemId').value;\n    if (!id) id = \"id_\" + Date.now().toString(36) + Math.random().toString(36).substring(2,8);\n    else id = String(id);\n    const data = { \n        id: id, \n        title: document.getElementById('editTitle').value, \n        author: document.getElementById('editAuthor').value, \n        content: document.getElementById('editMain').value, \n        content_pinyin: document.getElementById('editPy').value, \n        hint: document.getElementById('editHint').value \n    };\n    if (oldG && oldG !== g && poems[oldG]) poems[oldG] = poems[oldG].filter(x => String(x.id) !== id);\n    if (!poems[g]) poems[g] = [];\n    const idx = poems[g].findIndex(x => String(x.id) === id);\n    if (idx !== -1) poems[g][idx] = data;\n    else poems[g].push(data);\n    saveLocal();\n    closeModals();\n    showToast(\"保存成功\");\n};\n\nfunction closeModals(){ document.querySelectorAll('.modal').forEach(m=>m.style.display='none'); }\n\n// 云端同步函数（不变）\nasync function initCloudSession(mode){\n    currentMode=mode;\n    const url=document.getElementById('alistUrl').value.trim().replace(/\\/$/,''), u=document.getElementById('alistUser').value, p=document.getElementById('alistPass').value;\n    try{\n        const res=await fetch(`${url}/api/auth/login`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,password:p})});\n        const d=await res.json();\n        if(d.code!==200) throw d.message;\n        cachedToken=d.data.token;\n        document.getElementById('syncStatus').innerText='已连接';\n        fetchCloudList(\"/\");\n        document.getElementById('storageModal').style.display='flex';\n    } catch(e){ alert(\"连接失败:\"+e); }\n}\n\nasync function fetchCloudList(path){\n    const url=document.getElementById('alistUrl').value.trim().replace(/\\/$/,'');\n    const res=await fetch(`${url}/api/fs/list`,{method:'POST',headers:{'Authorization':cachedToken,'Content-Type':'application/json'},body:JSON.stringify({path,page:1,per_page:0})});\n    const d=await res.json();\n    currentCloudPath=path;\n    const con=document.getElementById('storageContainer');\n    con.innerHTML='';\n    d.data.content.forEach(f=>{\n        const div=document.createElement('div');\n        div.className='storage-card';\n        div.innerHTML=`<span>${f.name}</span><input type=\"radio\" name=\"cloudItem\" value=\"${f.name}\">`;\n        div.onclick=()=>{ if(f.is_dir) fetchCloudList((path===\"/\"?\"\":path)+\"/\"+f.name); else div.querySelector('input').checked=true; };\n        con.appendChild(div);\n    });\n    document.getElementById('btnConfirmStorage').onclick=executeCloudAction;\n}\n\nfunction goBackCloud(){ if(currentCloudPath!==\"/\") fetchCloudList(currentCloudPath.split('/').slice(0,-1).join('/')||\"/\"); }\n\nasync function executeCloudAction(){\n    const url=document.getElementById('alistUrl').value.trim().replace(/\\/$/,''), sel=document.querySelector('input[name=\"cloudItem\"]:checked');\n    if(currentMode==='upload'){\n        const blob=new Blob([JSON.stringify({poems,progress})],{type:'application/json'}), fd=new FormData();\n        fd.append('file',blob,'poem_data.json');\n        await fetch(`${url}/api/fs/form`,{method:'PUT',headers:{'Authorization':cachedToken,'File-Path':encodeURIComponent(currentCloudPath+'/poem_data.json')},body:fd});\n        showToast(\"同步成功\");\n    } else if(sel) {\n        const dRes=await fetch(`${url}/api/fs/get`,{method:'POST',headers:{'Authorization':cachedToken,'Content-Type':'application/json'},body:JSON.stringify({path:(currentCloudPath===\"/\"?\"\":currentCloudPath)+\"/\"+sel.value})});\n        const d=await dRes.json(), fRes=await fetch(d.data.raw_url), fD=await fRes.json();\n        poems=fD.poems; progress=fD.progress;\n        normalizeData();\n        saveLocal(); closeModals(); showToast(\"导入成功\");\n    }\n}\n\nfunction exportData(){\n    const a=document.createElement('a');\n    a.href=URL.createObjectURL(new Blob([JSON.stringify({poems,progress},null,2)],{type:'application/json'}));\n    a.download='poems_backup.json'; a.click();\n}\n</script>\n</body>\n</html>","isHtml":false,"htmlPath":"/Users/huangliting/Downloads/古诗","htmlFiles":[],"prefix":"Private","pcRepo":"PakePlus","iosRepo":"PakePlus-iOS","androidRepo":"PakePlus-Android","win7Repo":"","versionStr":"web10","more":{"windows":{"label":"aeadfcfbeecfeec","title":"智能古诗背诵系统","url":"localhost:7700/index.html","userAgent":"Mozilla/5.0 (iPhone; CPU iPhone OS 17_0_3 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1","width":430,"height":932,"theme":null,"resizable":true,"fullscreen":false,"maximized":false,"minWidth":400,"minHeight":300,"maxWidth":1920,"maxHeight":1080,"decorations":true,"transparent":false,"titleBarStyle":"Visible","visible":true,"focus":true,"closable":true,"minimizable":true,"maximizable":true,"alwaysOnTop":false,"alwaysOnBottom":false,"center":false,"shadow":true,"skipTaskbar":false,"tabbingIdentifier":null,"parent":null,"dragDropEnabled":true,"browserExtensionsEnabled":false,"devtools":true,"contentProtected":false,"hiddenTitle":false,"incognito":false,"proxyUrl":null,"useHttpsScheme":false,"zoomHotkeysEnabled":false,"acceptFirstMouse":false,"create":false,"backgroundColor":null,"backgroundThrottling":null,"javascriptDisabled":false}},"phone":{"fullScreen":false,"launchImage":"","screenOn":false,"download":true,"internet":true,"position":false,"direction":"default","callPhone":false,"microphone":false,"camera":false,"backgroundPlay":false,"compress":false,"appSize":0,"videoFull":true,"author":"pakeplus","startMethod":"none","startPwd":"","pwdTitle":"","pwdBtn":"","pwdPlace":"","pwdTip":"","pwdError":"","endPwd":"","endPwdTitle":"","endPwdTip":"","endPwdError":"","pwdStyle":"flat","pwdTheme":"dark","safeArea":{"top":0,"bottom":0,"left":0,"right":0},"header":{"show":false,"title":"","backgroundColor":"","color":"","fontSize":16,"fontWeight":"bold","loading":false,"toolBar":false,"toolBarBackgroundColor":"","toolBarColor":"","toolBarFontSize":16